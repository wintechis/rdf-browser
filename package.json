{
  "name": "rdf-browser",
  "version": "2.0.0",
  "description": "A Firefox Add-on that requests RDF files and renders RDF files as Turtle documents with clickable links",
  "license": "MIT",
  "scripts": {
    "build": "./script/build.sh",
    "browserify": "esbuild src/main.js --bundle --minify --outfile=build/main.js --global-name=app --platform=browser --alias:stream=stream-browserify --alias:buffer=buffer --alias:events=events --alias:util=util --alias:assert=assert --inject:src/process-inject.js",
    "release": "./script/release.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kianschmalenbach/rdf-browser.git"
  },
  "dependencies": {
    "@inrupt/solid-client-authn-browser": "^4.0.0",
    "jsonld-streaming-parser": "^5.0.1",
    "jsonld-streaming-serializer": "^4.0.0",
    "n3": "^1.26.0",
    "rdfxml-streaming-parser": "^3.2.0"
  },
  "devDependencies": {
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.27.4",
    "events": "^3.3.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  }
}
